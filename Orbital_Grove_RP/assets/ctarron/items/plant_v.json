{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "L",
        "model": {
          "type": "minecraft:model",
          "model": "ctarron:plant_vl"
        }
      },
      {
        "when": "R",
        "model": {
          "type": "minecraft:model",
          "model": "ctarron:plant_vr"
        }
      },
      {
        "when": "V",
        "model": {
          "type": "minecraft:model",
          "model": "ctarron:plant_v"
        }
      }
    ]
  }
}