{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "bulb",
        "model": {
          "type": "minecraft:model",
          "model": "ctarron:alarm_on"
        }
      },
      {
        "when": "ray",
        "model": {
          "type": "minecraft:model",
          "model": "ctarron:alarm_ray"
        }
      }
    ]
  }
}